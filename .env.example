# Optional: Google Gemini API key (kept strictly on the server; never expose to the browser)
# If omitted, School Smog Planner serves a clearly labeled deterministic fallback explanation.
GEMINI_API_KEY=

# Optional: Gemini model identifier (defaults to gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Server port (defaults to 3000 in production, 3001 in dev)
PORT=3000
